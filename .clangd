# clangd cannot find this project's compile database on its own.
#
# CMake writes compile_commands.json into core/build (CMAKE_EXPORT_COMPILE_COMMANDS
# is ON in core/CMakeLists.txt), but clangd only looks in the directory of the
# file being edited and its PARENTS. For core/app/engine/AudioEngine.cpp that is
# core/app/engine → core/app → core → repo root -- and core/build is on none of
# those paths. Without this file clangd falls back to guessing flags, which means
# no JUCE include paths, no JUCE_* defines and no C++20 -- so every JUCE header
# lights up with errors that do not exist in a real build.
#
# Path is relative to this file, so it works from any editor's working directory.
CompileFlags:
  CompilationDatabase: core/build

Diagnostics:
  # JUCE's modules are built as unity .cpp/.mm files; opening one of the headers
  # they include directly makes clangd complain the header is never included
  # anywhere it can see. That is a fact about the build shape, not a defect.
  UnusedIncludes: None
  MissingIncludes: None
  Suppress:
    # AudioEngine's class body is split across five fragment files that are
    # #included inside `class AudioEngine`. Each guards itself so that opening
    # one directly pulls in AudioEngine.h, which then includes it back in its
    # proper context -- that is what gives the editor a real AST for them
    # instead of 20-40 phantom errors (see AudioEngine.h's include block).
    #
    # clangd cannot put that round trip in a PREAMBLE, so it reports this one
    # diagnostic. A real compile has no such restriction; the build is clean.
    # Named explicitly rather than blanket-suppressed: it can only ever fire on
    # a file that includes itself, which is exactly this pattern.
    - pp_including_mainfile_in_preamble
