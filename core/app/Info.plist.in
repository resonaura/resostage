<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No Dock icon, ever -- headless backend (LSUIElement). File associations
	     are owned by the Electron shell (see electron/scripts/brand-mac-app.mjs),
	     not this nested Core bundle. Core receives open-project commands via IPC. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>ResoStage requires local network access for LAN discovery, stage lighting (Art-Net/DMX), and wireless remote control.</string>
</dict>
</plist>
